# ---------------------------------------------------------------------------
# Authentication — brokers sign in with their HRS CRM account.
# The AUTH project is the HRS CRM Supabase project. Only its PUBLIC anon key is
# used, in the browser and on the server. See ROA_CRM_Auth_Integration.md.
# ---------------------------------------------------------------------------

# Browser (inlined at build time — changing these needs a new deployment)
VITE_AUTH_SUPABASE_URL=https://<crm-project-ref>.supabase.co
VITE_AUTH_SUPABASE_ANON_KEY=<crm-project-anon-key>

# Server (serverless functions) — validates broker access tokens
AUTH_SUPABASE_URL=https://<crm-project-ref>.supabase.co
AUTH_SUPABASE_ANON_KEY=<crm-project-anon-key>

# Optional: honour the session tokens the CRM's "Open ROA System" button appends to
# the URL (automatic sign-in). Leave unset/false until the trade-offs in
# ROA_CRM_Auth_Integration.md are accepted. Tokens are scrubbed from the URL regardless.
# VITE_ENABLE_CRM_SESSION_HANDOFF=false

# ---------------------------------------------------------------------------
# ROA data — the ORIGINAL ROA Supabase project (roa_submissions + private
# `roa-pdfs` bucket). Server-side only: NEVER prefix with VITE_.
# ---------------------------------------------------------------------------
ROA_SUPABASE_URL=https://<roa-project-ref>.supabase.co
ROA_SUPABASE_SERVICE_ROLE_KEY=<roa-project-service-role-key>

# ---------------------------------------------------------------------------
# Legacy single-project names. Used ONLY when the matching new pair above is
# unset (this is the rollback path: unset AUTH_* / VITE_AUTH_* to restore the
# previous behaviour). Retire once the cutover is verified.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://<roa-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<roa-project-anon-key>
# SUPABASE_URL=https://<roa-project-ref>.supabase.co
# SUPABASE_ANON_KEY=<roa-project-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<roa-project-service-role-key>

# Authentication
# Set to 'false' to enable real auth. Any other value or missing = mock auth (open access).
VITE_USE_MOCK_AUTH=false

# Email (server-side only — NEVER prefix with VITE_)
# Used by the serverless function at /api/send-email
RESEND_API_KEY_R=re_xxxxxxxxxxxxxxxxxxxx

# Internal copy email address
INTERNAL_COPY_EMAIL=info@hrsinsurance.co.za
